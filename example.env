# Kopier til .env (cp example.env .env) og fyll inn. .env er ignorert av git.
GEMINI_API_KEY=
# Postgres-URI til agentens database. Supabase: Project Settings > Database > Connection string (URI).
AGENT_DB_URL=postgresql://postgres:PASSORD@db.PROSJEKT.supabase.co:5432/postgres
# Valgfritt (standardverdier vist):
# AGENT_CHAT_MODEL=gemini-3.8-flash
# AGENT_EMBEDDING_MODEL=gemini-embedding-2
# AGENT_EMBEDDING_DIM=768
# AGENT_SHOP_ID=1
# AGENT_TOP_K=6
# AGENT_REQUEST_TIMEOUT_MS=90000
